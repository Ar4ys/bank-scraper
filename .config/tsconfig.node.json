{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"include": ["../src", "../tools"],
	"compilerOptions": {
		"composite": true,
		"module": "NodeNext",
		"types": ["node"],
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true
	}
}
